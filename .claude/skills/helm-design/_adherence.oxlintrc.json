{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/outcomes/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|ghost|link|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'ghost' | 'link' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|elevation|state|density|surface|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, elevation, state, density, surface, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:e0|e1|e2|e3)$/]",
        "message": "<Card> elevation must be one of 'e0' | 'e1' | 'e2' | 'e3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:anchored|additive|replaced|attached|drift)$/]",
        "message": "<Card> state must be one of 'anchored' | 'additive' | 'replaced' | 'attached' | 'drift'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:editorial|compact)$/]",
        "message": "<Card> density must be one of 'editorial' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:log|app)$/]",
        "message": "<Card> surface must be one of 'log' | 'app'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|variant|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: label, children, variant, onRemove, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|observed)$/]",
        "message": "<Chip> variant must be one of 'solid' | 'outline' | 'observed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DriftFlag'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|statement|observed|question|actions|key|ref|className|style|children)$/]",
        "message": "<DriftFlag> doesn't accept that prop. Declared props: level, statement, observed, question, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='DriftFlag'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:notice|contradiction|halt)$/]",
        "message": "<DriftFlag> level must be one of 'notice' | 'contradiction' | 'halt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|htmlFor|muted|style|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: children, htmlFor, muted, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:anchor|helm-mark|bearing-off|shackle|sounding|beacon|half-mast|provenance|heading|logged|watch|search|close|chevron|more-vertical)$/]",
        "message": "<Icon> name must be one of 'anchor' | 'helm-mark' | 'bearing-off' | 'shackle' | 'sounding' | 'beacon' | 'half-mast' | 'provenance' | 'heading' | 'logged' | 'watch' | 'search' | 'close' | 'chevron' | 'more-vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|children|footer|width|onClose|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, description, children, footer, width, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutcomeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|title|quarter|replaces|observed|facts|reasons|actions|links|attached|children|key|ref|className|style|children)$/]",
        "message": "<OutcomeCard> doesn't accept that prop. Declared props: state, title, quarter, replaces, observed, facts, reasons, actions, links, attached, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutcomeCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:anchored|additive|replaced|drift)$/]",
        "message": "<OutcomeCard> state must be one of 'anchored' | 'additive' | 'replaced' | 'drift'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Table'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|style|key|ref|className|style|children)$/]",
        "message": "<Table> doesn't accept that prop. Declared props: columns, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|active|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, active, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|tone|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: message, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|error)$/]",
        "message": "<Toast> tone must be one of 'default' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|items|active|onNavigate|trailing|key|ref|className|style|children)$/]",
        "message": "<TopNav> doesn't accept that prop. Declared props: logoSrc, items, active, onNavigate, trailing."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
