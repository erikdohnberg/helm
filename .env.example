# Database (Prisma)
DATABASE_URL="file:./dev.db"

# Auth (NextAuth with Google). Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional site URL (AUTH_URL or NEXTAUTH_URL). Must match the origin you use in the browser (no path, no /*).
# Wildcards like http://localhost:3000/* become GET /%2A 404 and break NextAuth session fetch.
# AUTH_URL=http://localhost:3000

# Browser API key for Google Picker (Settings → Integrations → Choose charter folder). Same GCP project as AUTH_GOOGLE_ID; enable "Google Picker API"; HTTP referrer allowlist must match how you open the app (e.g. http://localhost:3000/* and http://127.0.0.1:3000/*). Restart dev after changes.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_NAME=#helm-quarterly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DOC_TEMPLATE_ID=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEMO_MODE=true
