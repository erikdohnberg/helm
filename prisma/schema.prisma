// Prisma schema for Helm — Auth.js (NextAuth) + organizations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Auth.js (NextAuth) models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  emailDomain   String?   // derived from email for org matching (e.g. acme.com)
  accounts      Account[]
  sessions      Session[]
  orgMembers    OrgMember[]
  invitesSent   Invite[]  @relation("InvitedBy")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Helm organization models ---

model Organization {
  id          String   @id @default(cuid())
  emailDomain String   @unique // e.g. acme.com; used to auto-join users from same domain
  name        String   @default("") // set during onboarding; empty = needs onboarding
  slug        String?  // optional for URLs
  createdAt   DateTime @default(now())
  /// Set when an owner completes the Google Drive OAuth consent for Helm (org-wide).
  googleDriveLinkedAt     DateTime?
  /// Google Drive folder ID for Outcome Charters (set after Connect Drive + setup).
  charterRootFolderId     String?
  charterRootFolderName   String?
  charterRootConfiguredAt DateTime?
  /// 1–12; first month of the organization’s fiscal year (e.g. 10 = October).
  fiscalYearStartMonth      Int?
  /// 1–12; first calendar month of the upcoming quarter (must match fiscal quarter slot).
  upcomingQuarterStartMonth Int?
  /// 1–4; which fiscal quarter (Q1–Q4) that period is.
  upcomingFiscalQuarter     Int?
  /// Resolved UTC range for the upcoming quarter (set during onboarding).
  upcomingQuarterStartDate  DateTime?
  upcomingQuarterEndDate    DateTime?
  /// Display year for FY label (e.g. 2026 → FY26), derived when saving quarter setup.
  upcomingFiscalYearLabel   Int?
  members     OrgMember[]
  invites     Invite[]
}

model OrgMember {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      String   @default("member") // owner | member
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Invite {
  id          String   @id @default(cuid())
  email       String
  orgId       String
  invitedById String
  token       String   @unique
  createdAt   DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([email, orgId])
}
